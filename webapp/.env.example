# Server-side only. Never prefix credentials with NEXT_PUBLIC_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same random secret as agent/.env.local.
CLINIC_AGENT_SECRET=
# Relative to webapp/, or an absolute local path.
DATABASE_PATH=./data/clinic-line.sqlite

# Optional Cloud transcript/log downloads. User session token, NOT room API secret.
# Requires an Admin user and project PII redaction. Keep server-side only.
LIVEKIT_CLOUD_PROJECT_ID=
LIVEKIT_CLOUD_SESSION_TOKEN=
