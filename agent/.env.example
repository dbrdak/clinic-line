LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Same random secret as webapp/.env.local; only needed for browser calls.
CLINIC_AGENT_SECRET=
CLINIC_API_URL=http://localhost:3000/api/
# Standalone demo only; browser calls always use the UI language.
DEMO_LANGUAGE=en
# Optional model overrides (defaults also live in src/models.ts).
LLM_MODEL=google/gemma-4-31b-it
STT_MODEL=google/gemini-3.5-transcribe-live
TTS_MODEL=google/gemini-3.8-flash-tts
TTS_VOICE=Zephyr
